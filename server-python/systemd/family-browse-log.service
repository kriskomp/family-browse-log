[Unit]
Description=family-browse-log ingest service (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
# Adjust paths/user to your netguard layout.
WorkingDirectory=/opt/family-browse-log/server-python
EnvironmentFile=/opt/family-browse-log/server-python/.env
ExecStart=/opt/family-browse-log/server-python/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5
User=www-data

[Install]
WantedBy=multi-user.target
