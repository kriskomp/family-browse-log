# Copy to .env on netguard and fill in. .env is git-ignored.

# --- MS SQL (database 'monitor') ---
FBL_DB_SERVER=docker
FBL_DB_PORT=1433
FBL_DB_NAME=monitor
FBL_DB_USER=change-me
FBL_DB_PASSWORD=change-me

# --- API tokens (two roles, must differ). Send as: Authorization: Bearer <token>
# agent : PC agents only (POST /ingest, GET /config). FBL_API_TOKEN is accepted as an alias.
FBL_AGENT_TOKEN=change-me-agent-token
# reader : Home Assistant only (GET /users, GET /activity). Cannot write or read config.
FBL_READER_TOKEN=change-me-reader-token

# --- read API limits ---
FBL_ACTIVITY_DEFAULT_LIMIT=20
FBL_ACTIVITY_MAX_LIMIT=200

# --- timezone used to bucket visits into a calendar Day ---
FBL_LOCAL_TZ=Europe/Warsaw
